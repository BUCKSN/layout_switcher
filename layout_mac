import sys

# Словарь соответствий EN -> RU
m_en = {
    "q": "й", "w": "ц", "e": "у", "r": "к", "t": "е", "y": "н", "u": "г", "i": "ш", "o": "щ", "p": "з",
    "[": "х", "]": "ъ", "a": "ф", "s": "ы", "d": "в", "f": "а", "g": "п", "h": "р", "j": "о", "k": "л",
    "l": "д", ";": "ж", "'": "э", "z": "я", "x": "ч", "c": "с", "v": "м", "b": "и", "n": "т", "m": "ь",
    ",": "б", ".": "ю", "/": ".", "`": "ё", "~": "Ё", "!": "!", "@": '"', "#": "№", "$": ";", "^": ":",
    "&": "?", "*": "*", "|": "/",
    "Q": "Й", "W": "Ц", "E": "У", "R": "К", "T": "Е", "Y": "Н", "U": "Г", "I": "Ш", "O": "Щ", "P": "З",
    "{": "Х", "}": "Ъ", "A": "Ф", "S": "Ы", "D": "В", "F": "А", "G": "П", "H": "Р", "J": "О", "K": "Л",
    "L": "Д", ":": "Ж", '"': "Э", "Z": "Я", "X": "Ч", "C": "С", "V": "М", "B": "И", "N": "Т", "M": "Ь",
    "<": "Б", ">": "Ю", "?": ","
}

# Автоматическое создание обратного словаря RU -> EN
m_ru = {v: k for k, v in m_en.items()}

def convert_text(text):
    result = []
    for char in text:
        # Пытаемся конвертировать из EN в RU, затем из RU в EN, иначе оставляем символ
        if char in m_en:
            result.append(m_en[char])
        elif char in m_ru:
            result.append(m_ru[char])
        else:
            result.append(char)
    return "".join(result)

if __name__ == "__main__":
    # Если текст передан аргументом командной строки
    if len(sys.argv) > 1:
        input_text = " ".join(sys.argv[1:])
        print(convert_text(input_text))
    else:
        # Интерактивный режим, если скрипт запущен без аргументов
        try:
            while True:
                line = input()
                print(convert_text(line))
        except (KeyboardInterrupt, EOFError):
            pass
